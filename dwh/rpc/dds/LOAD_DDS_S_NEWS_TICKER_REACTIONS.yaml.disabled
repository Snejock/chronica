input:
  redpanda:
    seed_brokers: ["dwh-rp-1:9092"]
    topics: ["CHR_NEWS_TRANSLATED"]
    consumer_group: "LOAD_DDS_S_NEWS_TICKER_REACTIONS"

pipeline:
  processors:
    - label: decode
      schema_registry_decode:
        url: "http://dwh-rp-1:8081"
    - catch:
        - log:
            level: ERROR
            message: "Error decoding avro: ${! error() }"
        - mapping: 'root = deleted()'

    - mapping: |
        root = if this.language_code != "en" { deleted() } else { this }

    # выполнение проверки в кэше, анализировалась ли эта новость ранее
    - branch:
        processors:
          - try:
              - label: redis_check
                cache:
                  resource: redis_cache
                  operator: exists
                  key: "processed:dds.s_news_ticker_reactions:${! this.news_link.string() }"
        result_map: 'meta is_processed = content().string().catch("false")'

    # если новость уже была обработана, удаляем ее из потока
    - mapping: |
        root = if meta("is_processed") == "true" { deleted() } else { this }

    # обращение к LLM для извлечения тикеров и оценок
    - branch:
        request_map: |
          let watchlist = """
            SBER: Sberbank Rossii PJSC, Сбербанк, Sberbank (Banking)
            ROSN: Rosneft PJSC, Роснефть, Rosneft (Energy)
            LKOH: LUKOIL PJSC, Лукойл, Lukoil (Energy, Oil)
            NVTK: NOVATEK PJSC, НОВАТЭК, Novatek (Energy, Gas)
            PLZL: Polyus PJSC, Полюс, Polyus (Gold Mining)
            GAZP: Gazprom PJSC, Газпром, Gazprom (Energy, Gas)
            GMKN: MMC NORILSK NICKEL PJSC, ГМК Норникель, Norilsk Nickel (Metals & Mining, Nickel/Palladium)
            SIBN: Gazprom Neft PJSC, Газпромнефть, Gazprom Neft (Energy, Oil)
            YDEX: IPJSC YANDEX, Яндекс, Yandex (Tech)
            TATN: TATNEFT n.a. V.D. Shashin, Татнефть, Tatneft (Energy, Oil)
            X5: X5 Corporate Center, ИКС-5 Ритейл, X5 Retail Group (Retail)
            MGNT: Magnit PJSC, Магнит, Magnit (Retail)
            LENT: Lenta IPJSC, Лента, Lenta (Retail)
            OZON: OZON Holding PJSC, Озон, Ozon (Retail)
            VTBR: Bank VTB PJSC, Банк ВТБ, VTB (Banking)
            MOEX: Moscow Exchange MICEX-RTS PJSC, Московская Биржа, MOEX (Exchange)
            SNGS: Surgutneftegas PJSC, Сургутнефтегаз, Surgutneftegas (Energy, Oil)
            IRAO: Inter RAO PJSC, Интер РАО, Inter RAO (Energy, Electric)
            TRNF: Transneft PJSC, Транснефть, Transneft (Oil Transport)
            CHMF: Severstal PJSC, Северсталь, Severstal (Steel)
            NLMK: NLMK PJSC, НЛМК, NLMK (Steel)
            MAGN: MMK PJSC, ММК, MMK (Steel)
            ALRS: AK ALROSA PJSC, Алроса, ALROSA (Diamonds)
            PHOR: PhosAgro PJSC, ФосАгро, PhosAgro (Fertilizers)
            AKRN: Acron PJSC, Акрон, Acron (Fertilizers)
            RUAL: United Company RUSAL IPJSC, Русал, RUSAL (Aluminium)
            FIXP: Fix Price Group Ltd, Фикс Прайс, Fix Price (Retail)
            MTSS: MTS PJSC, МТС, MTS (Telecom)
            PIKK: PIK SHb PJSC, Группа ПИК, PIK Group PJSC (Real Estate)
            AFLT: Aeroflot PJSC, Аэрофлот, Aeroflot (Aviation)
          """

          let system_instruction = """
            You are a Senior Quant Researcher.
            Your task is to extract trading signals from news articles for algorithmic trading.

            **Important: You must return a JSON array of objects with the following fields:**
            - ticker_code (string) — ticker from the provided Watchlist. If the news indirectly affects multiple companies (e.g., via oil prices, geopolitics, macroeconomics), you must list **all relevant tickers** from the list. Do not limit yourself to direct mentions.
            - category_nm (string) — one of: earnings, dividends, m_and_a, capital, legal, management, contracts, products, operations, ratings, macro, other.
            - impact_scr (integer) — from -100 to +100 (see scale below).
            - confidence_prt (float) — from 0.00 to 1.00. For events that have already occurred = 1.00.
            - reason_txt (string) — brief explanation in Russian.
            Provide an assessment and brief explanation for each ticker independently; do not link tickers to one another with phrases like "similarly", "also", etc.

            **Rules for ticker_code:**
            - If the news **directly mentions** a company from the Watchlist — include its ticker.
            - If the news **indirectly affects** a sector or the entire market (e.g., oil prices, sanctions, ruble exchange rate, geopolitics) — include **all tickers** from the Watchlist that fall under this influence.
            - If the impact extends to all companies in the list (macro shock, market panic) — list **all tickers**.
            - If the news is **completely unrelated** to any company in the list and does not affect their business — return an **empty array** `"tickers": []`.

            **Rules for reason_txt:**
            - Provide reasoning in the reason_txt field independently for each ticker; do not write "similarly", "also", etc.
            - Provide a clear and detailed reasoning.

            Examples:
            - News about rising oil prices → `ticker_code` = ["ROSN","LKOH","GAZP","SIBN","TATN"]
            - News about Domodedovo airport (no companies from the list) → `"tickers": []`
            - News about a lawsuit against Gazprom → `ticker_code` = ["GAZP"]

            Impact score scale (impact_scr -100..+100):
            Use the range from -100 to +100.

            Positive (+)
            +1..+10: Noise, rumors, forum participation.
            +10..+30: Positive operational news, minor contracts.
            +30..+70: Better-than-expected results, dividends, major contracts, court victories.
            +70..+100: M&A, record profits, buybacks, strategic breakthroughs.

            Negative (-)
            -1..-10: Negative rumors, criticism.
            -10..-30: Minor fines, rating downgrades.
            -30..-70: Worse-than-expected results, dividend cancellations, sanctions, major lawsuits.
            -70..-100: Default, criminal proceedings, disasters, market loss.

            Confidence (confidence_prt) must reflect the probability of the event occurring (if it has not yet happened).
            Use the range from 0.00 to 1.00 with two decimal places.
            For events that have already occurred, use confidence_prt = 1.00.

            Event types (strictly lowercase):
            - earnings: Financial reports (IFRS/RAS), operational results, revenue/profit guidance, report dates.
            - dividends: Board recommendations, payment approvals, record dates, dividend cancellations.
            - m_and_a: Mergers, acquisitions, stake purchases/sales, joint ventures (JV), restructuring.
            - capital: Share buybacks, additional share offerings (SPO/FPO), splits, bond issuances, debt management.
            - legal: Litigation, lawsuits, sanctions, asset freezes, regulatory fines (CBR, FAS), antitrust cases.
            - management: Executive appointments/departures (CEO, C-level), insider transactions, shareholder conflicts.
            - contracts: Winning/losing major tenders, signing strategic contracts, government orders.
            - products: New product launches, IT releases, patents, presentations, product recalls.
            - operations: Production metrics (output/sales), logistics, accidents, fires, facility openings/closures.
            - ratings: Target price changes by investment banks, credit rating updates by agencies.
            - macro: Exchange rates, commodity prices, central bank rates.
            - other: Everything that does not fit above (charity, HR, awards, insignificant noise).

            Respond in Russian language only for the reason_txt field.
          """

          let prompt_text = """
            Watchlist (ticker: description):
            """ + $watchlist + """

            News:
            Title: """ + this.title_txt.or("") + """
            Summary: """ + this.summary_txt.or("") + """

            Task:
            Analyze the news and return a JSON array of objects, where each object describes the impact on one ticker.
            Provide reasoning in the reason_txt field independently for each ticker.
            Rules:
            1. Include tickers even if the news has indirect influence (e.g., via commodity prices, geopolitics, macroeconomics).
            2. If the news affects multiple companies in the same sector — list them all.
            3. If the news is not related to any ticker from the Watchlist — return an empty array.
            4. Set confidence_prt = 1.00 for events that have already occurred (e.g., restrictions lifted, contract signed).
            5. Write the reason_txt field in Russian.

            Response format (strict):
            {
              "tickers": [
                {
                  "ticker_code": "SBER",
                  "category_nm": "macro",
                  "impact_scr": -15,
                  "confidence_prt": 0.85,
                  "reason_txt": "Example: ruble appreciation is negative for exporters"
                }
              ]
            }

            Your response (JSON only, no explanations):
          """
          root = {
            "model": "deepseek-v4-flash",
            "stream": false,
            "temperature": 0.0,
            "top_p": 0.1,
            "response_format": { "type": "json_object" },
            "messages": [
              { "role": "system", "content": $system_instruction },
              { "role": "user",   "content": $prompt_text }
            ]
          }
        processors:
          - label: http
            http:
              url: "https://api.deepseek.com/chat/completions"
              verb: POST
              headers:
                Content-Type: "application/json"
                Authorization: "Bearer ${DEEPSEEK_API_KEY}"
              timeout: 5m
              retries: 3
              retry_period: "5s"
          - catch:
              - log:
                  level: WARN
                  message: "❌ LLM API failed after retries: ${! error() }"
          - mapping: |
              let result = this.choices.index(0).message.content.parse_json().catch(null)
              root.llm_tickers = if $result != null { $result.tickers } else { [] }
        result_map: |
          root.tickers = this.llm_tickers

    - switch:
        - check: 'this.tickers.length().or(0) > 0'
          processors:
            - log:
                level: INFO
                message: '[🧠 LLM ANALYZED] Link: ${! this.news_link } | Found ${! this.tickers.length() } tickers. Tickers: ${! this.tickers.string() }'

output:
  label: load_dds_s_news_ticker_reactions
  broker:
    pattern: fan_out
    outputs:
      - label: out_postgres
        sql_raw:
          driver: postgres
          dsn: postgres://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:${PG_PORT}/${PG_DATABASE}?sslmode=disable
          query: |
            INSERT INTO dds.s_news_ticker_reactions (
              news_id, model_nm, ticker_code, category_nm, impact_scr, confidence_prt, reason_txt
            ) VALUES (xxh64($1), $2, $3, $4, $5, $6, $7)
            ON CONFLICT (news_id, ticker_code, model_nm) DO UPDATE SET
              _loaded_dttm = now(),
              model_nm = EXCLUDED.model_nm,
              category_nm = EXCLUDED.category_nm,
              impact_scr = EXCLUDED.impact_scr,
              confidence_prt = EXCLUDED.confidence_prt,
              reason_txt = EXCLUDED.reason_txt;
          args_mapping: |
            root = [
              this.news_link,
              this.model_nm,
              this.ticker_code,
              this.category_nm,
              this.impact_scr,
              this.confidence_prt,
              this.reason_txt
            ]
          batching:
            count: 10
            period: 1s
        processors:
          - mapping: |
              root = if this.tickers.length().or(0) == 0 { deleted() } else { this }

          - mapping: |
              let model = "deepseek-v4-flash:cloud"
              
              root = this.tickers.map_each(t -> {
                "news_link": this.news_link.string(),
                "model_nm": $model,
                "ticker_code": t.ticker_code.string().catch("unknown"),
                "category_nm": t.category_nm.string().catch("other"),
                "impact_scr": t.impact_scr.number().catch(0),
                "confidence_prt": t.confidence_prt.number().catch(0.0),
                "reason_txt": t.reason_txt.string().catch("")
              })

          - unarchive:
              format: json_array

      - label: out_redis
        cache:
          target: redis_cache
          key: "processed:dds.s_news_ticker_reactions:${! this.news_link.string() }"
        processors:
          - mapping: |
              root = if this.tickers.length().or(0) == 0 { deleted() } else { this }